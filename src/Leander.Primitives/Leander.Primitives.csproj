<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The configuration contract builder resolves unregistered primitive definitions via PrimitiveRegistry.TryResolve,
         collects primitive failures via PrimitiveRegistryBuilder.Build(out failures), and shares TypeNames. -->
    <InternalsVisibleTo Include="Leander.Configuration" />
  </ItemGroup>

</Project>
